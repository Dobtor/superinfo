<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="page_bot_view" model="ir.ui.view">
            <field name="name">共契BOT專區</field>
            <field name="type">qweb</field>
            <field name="key">superinfo_website_data.page_bot_view</field>
            <field name="arch" type="xml">
                <t name="共契BOT專區" t-name="superinfo_website_data.page_bot_view">
                    <t t-call="website.layout">
                        <div id="wrap" class="oe_structure">
            <section class="s_cover o_cc o_cc5 oe_img_bg o_bg_img_center pt176 pb176" data-snippet="s_cover" data-name="頁首" style="background-image: url('/superinfo_website_data/static/src/img/content/bot.png'); background-size: cover; background-position: center;">
                <div class="o_we_bg_filter bg-black-25"/>
                <div class="container"><div class="row"><div class="col-lg-8"><h1 class="display-2-fs">共契BOT專區</h1></div></div></div>
            </section>
            <section class="pt40 pb40" data-name="內容"><div class="container"><div class="si-stack">
                <img src="/superinfo_website_data/static/src/img/content/pages/bot/0.png" alt="共契BOT專區" loading="lazy"/>
                <img src="/superinfo_website_data/static/src/img/content/pages/bot/1.png" alt="共契BOT專區" loading="lazy"/>
                <img src="/superinfo_website_data/static/src/img/content/pages/bot/2.png" alt="共契BOT專區" loading="lazy"/>
            </div></div></section>
                        </div>
                    </t>
                </t>
            </field>
        </record>
        <record id="page_bot" model="website.page">
            <field name="name">共契BOT專區</field>
            <field name="is_published">True</field>
            <field name="url">/services/bot</field>
            <field name="view_id" ref="page_bot_view"/>
        </record>

        <record id="page_promise_view" model="ir.ui.view">
            <field name="name">PROMISE 安心承諾</field>
            <field name="type">qweb</field>
            <field name="key">superinfo_website_data.page_promise_view</field>
            <field name="arch" type="xml">
                <t name="PROMISE 安心承諾" t-name="superinfo_website_data.page_promise_view">
                    <t t-call="website.layout">
                        <div id="wrap" class="oe_structure">
            <section class="s_cover o_cc o_cc5 oe_img_bg o_bg_img_center pt176 pb176" data-snippet="s_cover" data-name="頁首" style="background-image: url('/superinfo_website_data/static/src/img/content/promise.jpg'); background-size: cover; background-position: center;">
                <div class="o_we_bg_filter bg-black-25"/>
                <div class="container"><div class="row"><div class="col-lg-8"><h1 class="display-2-fs">PROMISE 安心承諾</h1></div></div></div>
            </section>
            <section class="pt40 pb40" data-name="內容"><div class="container"><div class="si-stack">
                <img src="/superinfo_website_data/static/src/img/content/pages/promise/0.jpg" alt="PROMISE 安心承諾" loading="lazy"/>
            </div></div></section>
                        </div>
                    </t>
                </t>
            </field>
        </record>
        <record id="page_promise" model="website.page">
            <field name="name">PROMISE 安心承諾</field>
            <field name="is_published">True</field>
            <field name="url">/services/promise</field>
            <field name="view_id" ref="page_promise_view"/>
        </record>

    </data>
</odoo>
