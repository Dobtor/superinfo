<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- 網站名稱與首頁 -->
        <record id="website.default_website" model="website">
            <field name="name">極電資訊 Superinfo</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- 公司資料 -->
        <record id="base.main_company" model="res.company">
            <field name="name">極電資訊有限公司</field>
            <field name="email">services@superinfo.com.tw</field>
            <field name="website">https://www.superinfo.com.tw</field>
            <field name="logo" type="base64" file="superinfo_website_data/static/src/img/logo/superinfo_logo.png"/>
        </record>

    </data>
</odoo>
