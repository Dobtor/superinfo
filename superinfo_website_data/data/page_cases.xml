<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="page_cases_view" model="ir.ui.view">
            <field name="name">實際案例</field>
            <field name="type">qweb</field>
            <field name="key">superinfo_website_data.page_cases_view</field>
            <field name="arch" type="xml">
                <t name="實際案例" t-name="superinfo_website_data.page_cases_view">
                    <t t-call="website.layout">
                        <div id="wrap" class="oe_structure">

                            <section class="s_cover o_cc o_cc5 oe_img_bg o_bg_img_center pt176 pb176" data-snippet="s_cover" data-name="頁首"
                                     style="background-image: url('/superinfo_website_data/static/src/img/content/success.jpg'); background-size: cover; background-position: center;">
                                <div class="o_we_bg_filter bg-black-25"/>
                                <div class="container"><div class="row"><div class="col-lg-8"><h1 class="display-2-fs">實際案例</h1></div></div></div>
                            </section>

                            <section class="pt48 pb24" data-name="案例簡介">
                                <div class="container"><div class="si-prose" style="text-align:center">
                                    <h3>逾 50 間 Mac 電腦教室建置實績</h3>
                                    <p>極電資訊自 2002 年以來，已協助大專院校、國高中小與公部門建置與規劃逾 50 間 Mac 電腦教室及 iPad 大量部署，並提供網路與資訊系統架設、MDM 行動裝置管理等完整服務。以下為部分實際建置案例。</p>
                                </div></div>
                            </section>

                            <section class="pt8 pb40" data-name="成功實例">
                                <div class="container">
                                    <div class="si-grid si-grid-3">
                                        <img src="/superinfo_website_data/static/src/img/content/pages/success/6.jpg" alt="Mac 電腦教室實例" loading="lazy"/>
                                        <img src="/superinfo_website_data/static/src/img/content/pages/success/7.jpg" alt="Mac 電腦教室實例" loading="lazy"/>
                                        <img src="/superinfo_website_data/static/src/img/content/pages/success/8.jpg" alt="Mac 電腦教室實例" loading="lazy"/>
                                        <img src="/superinfo_website_data/static/src/img/content/pages/success/9.jpg" alt="Mac 電腦教室實例" loading="lazy"/>
                                        <img src="/superinfo_website_data/static/src/img/content/pages/success/10.jpg" alt="Mac 電腦教室實例" loading="lazy"/>
                                        <img src="/superinfo_website_data/static/src/img/content/pages/success/11.jpg" alt="Mac 電腦教室實例" loading="lazy"/>
                                    </div>
                                </div>
                            </section>

                            <section class="s_text_block o_cc o_cc1 pt40 pb56" data-snippet="s_text_block" data-name="客戶回饋">
                                <div class="container si-contact">
                                    <h3 class="text-center mb-4">客戶回饋</h3>
                                    <div class="row">
                                        <div class="col-lg-4 si-contact-item"><blockquote class="blockquote"><p>「極電服務有問必答，服務周到！」</p><footer class="blockquote-footer">台藝大老師</footer></blockquote></div>
                                        <div class="col-lg-4 si-contact-item"><blockquote class="blockquote"><p>「價格合理，對電腦安裝後續交待很清楚，服務品質態度很好！」</p><footer class="blockquote-footer">士林高商廣設科主任</footer></blockquote></div>
                                        <div class="col-lg-4 si-contact-item"><blockquote class="blockquote"><p>「整線、整合教室環境做得不錯，能迅速了解狀況，給予支援。」</p><footer class="blockquote-footer">景美女中資訊組長</footer></blockquote></div>
                                    </div>
                                </div>
                            </section>

                        </div>
                    </t>
                </t>
            </field>
        </record>

        <record id="page_cases" model="website.page">
            <field name="name">實際案例</field>
            <field name="is_published">True</field>
            <field name="url">/services/cases</field>
            <field name="view_id" ref="page_cases_view"/>
        </record>

    </data>
</odoo>
