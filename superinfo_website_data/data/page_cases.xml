<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- 實際案例入口頁：對齊原站 K12/High ED 兩段、2 欄校名網格；每張卡連到對應網誌文章 -->
        <record id="page_cases_view" model="ir.ui.view">
            <field name="name">實際案例</field>
            <field name="type">qweb</field>
            <field name="key">superinfo_website_data.page_cases_view</field>
            <field name="arch" type="xml">
                <t name="實際案例" t-name="superinfo_website_data.page_cases_view">
                    <t t-call="website.layout">
                        <div id="wrap" class="oe_structure">

                            <section class="s_cover o_cc o_cc5 oe_img_bg o_bg_img_center pt176 pb176" data-snippet="s_cover" data-name="頁首"
                                     style="background-image: url('/superinfo_website_data/static/src/img/content/success.jpg'); background-size: cover; background-position: center;">
                                <div class="o_we_bg_filter bg-black-25"/>
                                <div class="container"><div class="row"><div class="col-lg-8"><h1 class="display-2-fs">實際案例</h1></div></div></div>
                            </section>

                            <section class="si-page pt40 pb56" data-name="成功實例">
                                <div class="container">
                                    <div class="si-cases">

                                        <div class="si-cases-head">Mac Lab 成功實例 — K12</div>
                                        <div class="si-school-grid">
                                            <a t-att-href="request.env.ref('superinfo_website_data.case_nangang').website_url" class="si-school-block">
                                                <div class="si-brush">南港高中</div>
                                                <div class="si-subtitle">Mac mini 資訊科技教室</div>
                                                <img src="/superinfo_website_data/static/src/img/cases/nangang.jpg" alt="南港高中 Mac mini 資訊科技教室" loading="lazy"/>
                                            </a>
                                            <a t-att-href="request.env.ref('superinfo_website_data.case_dongmen').website_url" class="si-school-block">
                                                <div class="si-brush">東門國小</div>
                                                <div class="si-subtitle">Mac mini 電腦教室</div>
                                                <img src="/superinfo_website_data/static/src/img/cases/dongmen.jpg" alt="東門國小 Mac mini 電腦教室" loading="lazy"/>
                                            </a>
                                            <a t-att-href="request.env.ref('superinfo_website_data.case_jingmei_mini').website_url" class="si-school-block">
                                                <div class="si-brush">景美女中</div>
                                                <div class="si-subtitle">Mac mini 多媒體教室</div>
                                                <img src="/superinfo_website_data/static/src/img/cases/jingmei_mini.jpg" alt="景美女中 Mac mini 多媒體教室" loading="lazy"/>
                                            </a>
                                            <a t-att-href="request.env.ref('superinfo_website_data.case_jingmei_imac').website_url" class="si-school-block">
                                                <div class="si-brush">景美女中</div>
                                                <div class="si-subtitle">iMac 教室</div>
                                                <img src="/superinfo_website_data/static/src/img/cases/jingmei_imac.jpg" alt="景美女中 iMac 教室" loading="lazy"/>
                                            </a>
                                        </div>

                                        <div class="si-cases-head">Mac Lab 成功實例 — High ED</div>
                                        <div class="si-school-grid">
                                            <a t-att-href="request.env.ref('superinfo_website_data.case_taiwanarts').website_url" class="si-school-block">
                                                <div class="si-brush">國立臺灣藝術大學</div>
                                                <div class="si-subtitle">Mac mini 資訊科技教室</div>
                                                <img src="/superinfo_website_data/static/src/img/cases/taiwanarts.jpg" alt="國立臺灣藝術大學 Mac mini 資訊科技教室" loading="lazy"/>
                                            </a>
                                            <a t-att-href="request.env.ref('superinfo_website_data.case_taiwantech').website_url" class="si-school-block">
                                                <div class="si-brush">國立臺灣科技大學</div>
                                                <div class="si-subtitle">iMac 電腦教室</div>
                                                <img src="/superinfo_website_data/static/src/img/cases/taiwantech.jpg" alt="國立臺灣科技大學 iMac 電腦教室" loading="lazy"/>
                                            </a>
                                        </div>

                                    </div>
                                </div>
                            </section>

                        </div>
                    </t>
                </t>
            </field>
        </record>

        <record id="page_cases" model="website.page">
            <field name="name">實際案例</field>
            <field name="is_published">True</field>
            <field name="url">/services/cases</field>
            <field name="view_id" ref="page_cases_view"/>
        </record>

    </data>
</odoo>
