<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ════════ 最新消息 部落格 ════════ -->
        <record id="blog_news" model="blog.blog">
            <field name="name">最新消息</field>
            <field name="subtitle">極電資訊・產品與活動公告</field>
        </record>

        <record id="news_post_store_opening" model="blog.post">
            <field name="name">2025 年師大門市開幕活動優惠～3 月底為止</field>
            <field name="blog_id" ref="blog_news"/>
            <field name="is_published">True</field>
            <field name="content"><![CDATA[
                <p><img src="/superinfo_website_data/static/src/img/banner/banner_open.png" class="img img-fluid" alt="師大門市開幕"/></p>
                <p>極電資訊師大校園體驗中心全新門市開幕！即日起至 3 月底，多項 Apple 教育優惠商品同步登場，歡迎師生親臨體驗。</p>
            ]]></field>
        </record>

        <record id="news_post_courses" model="blog.post">
            <field name="name">極電開課中！內容有料、課程無料！2024 為教師打造高含金量 Mac、iPad 實體課程</field>
            <field name="blog_id" ref="blog_news"/>
            <field name="is_published">True</field>
            <field name="content"><![CDATA[
                <p><img src="/superinfo_website_data/static/src/img/content/courses.png" class="img img-fluid" alt="教師課程"/></p>
                <p>2024 全新教師實體課程開跑，由專業講師帶領，從 Mac、iPad 教學應用到課堂實作，內容紮實、報名免費，名額有限。</p>
            ]]></field>
        </record>

        <record id="news_post_ipad_pro_m4" model="blog.post">
            <field name="name">iPad Pro M4 全新新品預約中！</field>
            <field name="blog_id" ref="blog_news"/>
            <field name="is_published">True</field>
            <field name="content"><![CDATA[
                <p><img src="/superinfo_website_data/static/src/img/banner/banner_ipad_pro_m4.png" class="img img-fluid" alt="iPad Pro M4"/></p>
                <p>搭載 M4 晶片的全新 iPad Pro 開放預約，效能再進化，創作與生產力一次到位。立即前往商城選購。</p>
            ]]></field>
        </record>

        <record id="news_post_ipad_air_m2" model="blog.post">
            <field name="name">iPad Air M2 全新新品預約中！</field>
            <field name="blog_id" ref="blog_news"/>
            <field name="is_published">True</field>
            <field name="content"><![CDATA[
                <p><img src="/superinfo_website_data/static/src/img/banner/banner_ipad_air_m2.png" class="img img-fluid" alt="iPad Air M2"/></p>
                <p>全新 iPad Air M2 開放預約，輕薄機身搭配 M2 效能，學生與行動工作者的最佳選擇。</p>
            ]]></field>
        </record>

    </data>
</odoo>
