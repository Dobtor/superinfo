<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ════════ 實際案例 部落格 ════════ -->
        <record id="blog_cases" model="blog.blog">
            <field name="name">實際案例</field>
            <field name="subtitle">極電資訊・Mac 電腦教室建置實績</field>
        </record>

        <!-- 分組標籤（對應原站 Mac Lab 成功實例 K12 / High ED） -->
        <record id="case_tag_k12" model="blog.tag">
            <field name="name">K12</field>
        </record>
        <record id="case_tag_highed" model="blog.tag">
            <field name="name">High ED</field>
        </record>

        <!-- ───── K12 ───── -->
        <record id="case_nangang" model="blog.post">
            <field name="name">南港高中 — Mac mini 資訊科技教室</field>
            <field name="blog_id" ref="blog_cases"/>
            <field name="tag_ids" eval="[(6,0,[ref('case_tag_k12')])]"/>
            <field name="is_published">True</field>
            <field name="cover_properties">{"background-image": "url('/superinfo_website_data/static/src/img/cases/nangang.jpg')", "resize_class": "o_record_has_cover o_half_screen_height", "opacity": "0.4"}</field>
            <field name="content"><![CDATA[
                <p class="text-center"><img src="/superinfo_website_data/static/src/img/cases/nangang.jpg" class="img img-fluid rounded mx-auto" alt="南港高中 Mac mini 資訊科技教室"/></p>
                <p class="text-center text-muted">南港高中・Mac mini 資訊科技教室</p>
            ]]></field>
        </record>

