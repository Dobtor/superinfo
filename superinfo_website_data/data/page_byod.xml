<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="page_byod_view" model="ir.ui.view">
            <field name="name">BYOD 自帶載具計畫</field>
            <field name="type">qweb</field>
            <field name="key">superinfo_website_data.page_byod_view</field>
            <field name="arch" type="xml">
                <t name="BYOD 自帶載具計畫" t-name="superinfo_website_data.page_byod_view">
                    <t t-call="website.layout">
                        <div id="wrap" class="oe_structure">

                            <section class="s_cover o_cc o_cc5 oe_img_bg o_bg_img_center pt176 pb176" data-snippet="s_cover" data-name="頁首"
                                     style="background-image: url('/superinfo_website_data/static/src/img/content/byod.jpg'); background-size: cover; background-position: center;">
                                <div class="o_we_bg_filter bg-black-25"/>
                                <div class="container"><div class="row"><div class="col-lg-8"><h1 class="display-2-fs">BYOD 自帶載具到校學習計畫</h1></div></div></div>
                            </section>

                            <section class="si-page pt24 pb24" data-name="BYOD 內容">

                                <div class="maincontainer">
                                    <div class="part2">
                                        <div class="head3 midgrayword">陪伴孩子的學習工具</div>
                                        <div class="part-p grayword">時代在走，變化要有！過往的教學方式已經悄悄轉型之中。不論是因為疫情而轉變的學習方式，還是現代人了解與消化知識的管道逐漸多元，「學習」這件事已不再只發生於教室與紙本之間。</div>
                                    </div>
                                    <div class="part2 reverse-order"><img class="part-img" src="/superinfo_website_data/static/src/img/content/pages/byod/0.jpg" alt="BYOD" loading="lazy"/></div>
                                </div>

                            </section>

                            <section class="pt8 pb40" data-name="培養數位能力">
                                <div class="container"><div class="si-prose">
                                    <h3>培養數位能力</h3>
                                    <p>根據 ISA 預測，未來 90% 以上的工作皆需要依靠數位技能，從小培養數位能力，是眼下教育界重要的發展趨勢。</p>
                                    <p>iPad 目前是多數學校選擇的數位學習工具之一，學校與政府單位都在為了孩子們的學習工具努力著，但考量現實層面，校內可提供的資源依然有限，自備數位工具（自帶載具）到校學習成為趨勢之一。</p>
                                    <p>以往經驗來說，校內統一裝置管理除了讓教師課程進行順暢，也能弭平同學間介面、軟體之落差，故政府單位有意推行 BYOD 計畫，讓學習工具可以同時滿足教學與管理需求。</p>
                                </div></div>
                            </section>

                            <section class="si-page pt8 pb40" data-name="我們提供的服務">
                                <div class="container"><div class="si-prose" style="text-align:center"><h3>我們提供的服務</h3><p>由 BYOD 配合之學校聯繫後，提供以下服務：</p></div></div>

                                <div class="maincontainer">
                                    <div class="part2">
                                        <div class="head3 midgrayword">機型與配件報價</div>
                                        <div class="part-p grayword">協助學校評估需求，提供合適的平板電腦機型與配件組合報價。</div>
                                    </div>
                                    <div class="part2 reverse-order"><img class="part-img" src="/superinfo_website_data/static/src/img/content/pages/byod/1.png" alt="機型與配件報價" loading="lazy"/></div>
                                </div>
                                <div class="maincontainer">
                                    <div class="part2"><img class="part-img" src="/superinfo_website_data/static/src/img/content/pages/byod/2.png" alt="MDM 行動裝置管理" loading="lazy"/></div>
                                    <div class="part2">
                                        <div class="head3 midgrayword">MDM 行動裝置管理</div>
                                        <div class="part-p grayword">提供 MDM 行動裝置管理建議與規劃，協助學校管理學生裝置與應用程式。</div>
                                    </div>
                                </div>
                                <div class="maincontainer">
                                    <div class="part2">
                                        <div class="head3 midgrayword">到校工作會議</div>
                                        <div class="part-p grayword">提供到校工作會議，協助學校設立 BYOD 推動工作小組，並提供相關諮詢與建議。</div>
                                    </div>
                                    <div class="part2 reverse-order"><img class="part-img" src="/superinfo_website_data/static/src/img/content/pages/byod/3.png" alt="到校工作會議" loading="lazy"/></div>
                                </div>

                            </section>

                        </div>
                    </t>
                </t>
            </field>
        </record>

        <record id="page_byod" model="website.page">
            <field name="name">BYOD 自帶載具計畫</field>
            <field name="is_published">True</field>
            <field name="url">/services/byod</field>
            <field name="view_id" ref="page_byod_view"/>
        </record>

    </data>
</odoo>
