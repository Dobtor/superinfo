<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Apple-specific tab to product.template form -->
    <record id="product_template_form_apple" model="ir.ui.view">
        <field name="name">product.template.form.apple</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="前台描述" name="frontend_description">
                    <group string="商品簡介">
                        <field name="configurator_intro" nolabel="1"/>
                    </group>
                    <group string="商品詳情">
                        <field name="configurator_detail" nolabel="1"/>
                    </group>
                </page>
                <page string="雷射刻字" name="engraving">
                    <group string="雷射刻字選項">
                        <group>
                            <field name="has_pencil_engraving"/>
                            <field name="has_ipad_engraving"/>
                        </group>
                    </group>
                </page>
                <page string="Apple Configurator" name="apple_configurator"
                      invisible="not is_mac_product">
                    <group>
                        <group>
                            <field name="is_mac_product" readonly="1"/>
                            <field name="mac_color_attribute_id"
                                   domain="[('display_type', '=', 'color')]"/>
                        </group>
                    </group>
                    <group string="Default Selected Options (when configurator first loads)">
                        <field name="mac_default_ptav_ids" nolabel="1" widget="many2many_tags"
                               domain="[('product_tmpl_id', '=', id)]"/>
                    </group>
                    <group string="Compare Table Specs (shown at bottom of configurator)">
                        <field name="mac_compare_spec_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="label"/>
                                <field name="value"/>
                                <field name="icon" widget="image" optional="hide"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
