<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Cart line — inject PTAV breakdown pills beneath the product name on
        /shop/cart for Mac products only. Non-Mac lines are unaffected.

        Uses <record model="ir.ui.view"> directly instead of <template>
        shorthand: theme_ prefixed modules have their <template> elements
        routed to the theme.ir.ui.view staging table, which is invisible
        to request.render() until the theme is applied.
    -->
    <record id="cart_line_apple_specs" model="ir.ui.view">
        <field name="name">Apple-style Mac spec breakdown in cart</field>
        <field name="type">qweb</field>
        <field name="inherit_id" ref="website_sale.cart_line_product_link"/>
        <field name="arch" type="xml">
            <xpath expr="//a" position="after">
                <t t-if="line.product_id.product_tmpl_id.is_mac_product">
                    <ul class="apple-spec-list">
                        <t t-foreach="line.product_id.product_template_attribute_value_ids"
                           t-as="ptav">
                            <li class="spec-item">
                                <span class="spec-label" t-esc="ptav.attribute_id.name + ':'"/>
                                <span class="spec-value" t-esc="ptav.name"/>
                            </li>
                        </t>
                    </ul>
                </t>
                <t t-if="line.pencil_engraving_text or line.ipad_engraving_text">
                    <ul class="apple-spec-list" style="margin-top:4px">
                        <t t-if="line.pencil_engraving_text">
                            <li class="spec-item">
                                <span class="spec-label">Apple Pencil 刻字：</span>
                                <span class="spec-value" t-esc="line.pencil_engraving_text"/>
                            </li>
                        </t>
                        <t t-if="line.ipad_engraving_text">
                            <li class="spec-item">
                                <span class="spec-label">iPad 刻字：</span>
                                <span class="spec-value" t-esc="line.ipad_engraving_text"/>
                            </li>
                        </t>
                    </ul>
                </t>
            </xpath>
        </field>
    </record>

    <!--
        Checkout / 訂單完成頁（checkout_layout 右側訂單摘要）— 在品名下方
        顯示雷射刻字內容。/shop/checkout、/shop/payment、/shop/confirmation
        共用此 layout。
    -->
    <record id="checkout_summary_engraving" model="ir.ui.view">
        <field name="name">Engraving text in checkout order summary</field>
        <field name="type">qweb</field>
        <field name="inherit_id" ref="website_sale.checkout_layout"/>
        <field name="arch" type="xml">
            <xpath expr="//td[@name='website_sale_cart_summary_product_name']/h6" position="after">
                <div t-if="line.pencil_engraving_text" class="text-muted fst-italic small">
                    <span>Apple Pencil 刻字：</span>
                    <span t-esc="line.pencil_engraving_text"/>
                </div>
                <div t-if="line.ipad_engraving_text" class="text-muted fst-italic small">
                    <span>iPad 刻字：</span>
                    <span t-esc="line.ipad_engraving_text"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
