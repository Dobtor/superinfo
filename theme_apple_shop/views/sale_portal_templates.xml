<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Portal 訂單/報價頁（/my/orders、/my/quotes）— 在商品名稱欄位下方
        顯示雷射刻字內容，讓客戶在確認報價/訂單時能核對刻字文字。

        Uses <record model="ir.ui.view"> directly instead of <template>
        shorthand: theme_ prefixed modules have their <template> elements
        routed to the theme.ir.ui.view staging table, which is invisible
        to request.render() until the theme is applied.
    -->
    <record id="sale_order_portal_content_engraving" model="ir.ui.view">
        <field name="name">Engraving text on portal order lines</field>
        <field name="type">qweb</field>
        <field name="inherit_id" ref="sale.sale_order_portal_content"/>
        <field name="arch" type="xml">
            <xpath expr="//td[@id='product_name']" position="inside">
                <!-- 標籤淺、內容深：刻字內容是客戶要核對的重點，不弱化；
                     「」界定內容邊界（刻字對前後空格敏感）；中文不用斜體 -->
                <div t-if="line.pencil_engraving_text">
                    <span class="text-muted">Apple Pencil 刻字：</span>
                    <span>「<t t-out="line.pencil_engraving_text"/>」</span>
                </div>
                <div t-if="line.ipad_engraving_text">
                    <span class="text-muted">iPad 刻字：</span>
                    <span>「<t t-out="line.ipad_engraving_text"/>」</span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
