<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Accessories — separate product.template records, attached to Mac
            products via optional_product_ids (website_sale built-in).
            Configurator surfaces them as Yes/No toggles or multi-select cards.
        -->

        <!-- Magic Mouse -->
        <record id="prod_magic_mouse" model="product.template">
            <field name="name">巧控滑鼠</field>
            <field name="default_code">MAGIC-MOUSE</field>
            <field name="type">consu</field>
            <field name="list_price">3290</field>
            <field name="is_published">True</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="description_sale">無線、可充電的滑鼠</field>
            <field name="apple_panel_section">accessory</field>
        </record>

        <!-- Magic Trackpad -->
        <record id="prod_magic_trackpad" model="product.template">
            <field name="name">巧控觸控板</field>
            <field name="default_code">MAGIC-TRACKPAD</field>
            <field name="type">consu</field>
            <field name="list_price">4990</field>
            <field name="is_published">True</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="description_sale">支援 Multi-Touch 手勢的觸控板</field>
            <field name="apple_panel_section">accessory</field>
        </record>

        <!-- Magic Keyboard -->
        <record id="prod_magic_keyboard" model="product.template">
            <field name="name">巧控鍵盤 — 注音</field>
            <field name="default_code">MAGIC-KB-ZHUYIN</field>
            <field name="type">consu</field>
            <field name="list_price">3290</field>
            <field name="is_published">True</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="description_sale">無線、可充電的鍵盤</field>
            <field name="apple_panel_section">accessory</field>
        </record>

        <!-- Magic Keyboard with Touch ID -->
        <record id="prod_magic_keyboard_touchid" model="product.template">
            <field name="name">巧控鍵盤含 Touch ID — 注音</field>
            <field name="default_code">MAGIC-KB-TOUCHID</field>
            <field name="type">consu</field>
            <field name="list_price">4290</field>
            <field name="is_published">True</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="description_sale">內建 Touch ID 的無線鍵盤</field>
            <field name="apple_panel_section">accessory</field>
        </record>

        <!-- Final Cut Pro pre-install — Apple TW: NT$9,990 -->
        <record id="prod_final_cut_pro" model="product.template">
            <field name="name">Final Cut Pro</field>
            <field name="default_code">SW-FCP</field>
            <field name="type">service</field>
            <field name="list_price">9990</field>
            <field name="is_published">True</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="description_sale">專業影片編輯軟體，預先安裝在你的 Mac 上</field>
            <field name="apple_panel_section">software</field>
            <field name="apple_license_url">https://www.apple.com/legal/sla/docs/FinalCutPro.pdf</field>
        </record>

        <!-- Logic Pro pre-install — Apple TW: NT$6,990 -->
        <record id="prod_logic_pro" model="product.template">
            <field name="name">Logic Pro</field>
            <field name="default_code">SW-LP</field>
            <field name="type">service</field>
            <field name="list_price">6990</field>
            <field name="is_published">True</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="description_sale">專業音樂製作軟體，預先安裝在你的 Mac 上</field>
            <field name="apple_panel_section">software</field>
            <field name="apple_license_url">https://www.apple.com/legal/sla/docs/LogicPro.pdf</field>
        </record>

        <!-- AppleCare+ — generic; in real Apple flow each product has its own SKU -->
        <record id="prod_applecare_mac" model="product.template">
            <field name="name">AppleCare+ for Mac</field>
            <field name="default_code">APPLECARE-MAC</field>
            <field name="type">service</field>
            <field name="list_price">8990</field>
            <field name="is_published">True</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="description_sale">3 年硬體保固 + 意外損壞保護</field>
            <field name="apple_panel_section">applecare</field>
        </record>

    </data>
</odoo>
