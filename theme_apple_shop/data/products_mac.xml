<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             Mac mini — full configurator showcase
             Attributes: chip / memory / storage / ethernet
             Plus optional accessories: mouse, keyboard, software, AppleCare
             ============================================================ -->
        <record id="prod_mac_mini" model="product.template">
            <field name="name">Mac mini</field>
            <field name="default_code">MAC-MINI</field>
            <field name="type">consu</field>
            <field name="list_price">26900</field>
            <field name="is_published">True</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="description_sale">迷你體積，威猛實力。Mac mini 配備 M4 晶片，為桌上型運算重新定義效能。</field>
            <field name="public_categ_ids" eval="[(6, 0, [ref('categ_mac_mini')])]"/>
            <field name="optional_product_ids" eval="[(6, 0, [
                ref('prod_magic_mouse'),
                ref('prod_magic_keyboard'),
                ref('prod_magic_keyboard_touchid'),
                ref('prod_magic_trackpad'),
                ref('prod_final_cut_pro'),
                ref('prod_logic_pro'),
                ref('prod_applecare_mac'),
            ])]"/>
        </record>

        <!-- Mac mini attribute lines: chip / memory / storage / ethernet -->
        <record id="prod_mac_mini_line_chip" model="product.template.attribute.line">
            <field name="product_tmpl_id" ref="prod_mac_mini"/>
            <field name="attribute_id" ref="attr_chip"/>
            <field name="value_ids" eval="[(6, 0, [
                ref('attr_val_chip_m4'),
                ref('attr_val_chip_m4_pro'),
            ])]"/>
        </record>
        <record id="prod_mac_mini_line_memory" model="product.template.attribute.line">
            <field name="product_tmpl_id" ref="prod_mac_mini"/>
            <field name="attribute_id" ref="attr_memory"/>
            <field name="value_ids" eval="[(6, 0, [
                ref('attr_val_mem_16'),
                ref('attr_val_mem_24'),
                ref('attr_val_mem_32'),
                ref('attr_val_mem_48'),
                ref('attr_val_mem_64'),
            ])]"/>
        </record>
        <record id="prod_mac_mini_line_storage" model="product.template.attribute.line">
            <field name="product_tmpl_id" ref="prod_mac_mini"/>
            <field name="attribute_id" ref="attr_storage"/>
            <field name="value_ids" eval="[(6, 0, [
                ref('attr_val_storage_256'),
                ref('attr_val_storage_512'),
                ref('attr_val_storage_1tb'),
                ref('attr_val_storage_2tb'),
                ref('attr_val_storage_4tb'),
                ref('attr_val_storage_8tb'),
            ])]"/>
        </record>
        <record id="prod_mac_mini_line_ethernet" model="product.template.attribute.line">
            <field name="product_tmpl_id" ref="prod_mac_mini"/>
            <field name="attribute_id" ref="attr_ethernet"/>
            <field name="value_ids" eval="[(6, 0, [
                ref('attr_val_ether_1g'),
                ref('attr_val_ether_10g'),
            ])]"/>
        </record>

        <!-- Compare table rows for Mac mini -->
        <record id="cmp_mm_chip" model="mac.compare.spec">
            <field name="product_tmpl_id" ref="prod_mac_mini"/>
            <field name="sequence">10</field>
            <field name="label">處理器</field>
            <field name="value">Apple M4 / M4 Pro 晶片
最高 14 核心 CPU、20 核心 GPU
最高 16 核心神經網路引擎</field>
        </record>
        <record id="cmp_mm_memory" model="mac.compare.spec">
            <field name="product_tmpl_id" ref="prod_mac_mini"/>
            <field name="sequence">20</field>
            <field name="label">記憶體</field>
            <field name="value">16GB 統一記憶體（標配）
可升級至 64GB</field>
        </record>
        <record id="cmp_mm_storage" model="mac.compare.spec">
            <field name="product_tmpl_id" ref="prod_mac_mini"/>
            <field name="sequence">30</field>
            <field name="label">儲存裝置</field>
            <field name="value">256GB SSD（標配）
可升級至 8TB</field>
        </record>
        <record id="cmp_mm_ports" model="mac.compare.spec">
            <field name="product_tmpl_id" ref="prod_mac_mini"/>
            <field name="sequence">40</field>
            <field name="label">連接埠</field>
            <field name="value">前面板 2 × USB-C
背面板 3 × Thunderbolt 4 / USB-C
HDMI、Gigabit 乙太網路（可升級至 10Gb）、3.5mm 耳機孔</field>
        </record>
        <record id="cmp_mm_size" model="mac.compare.spec">
            <field name="product_tmpl_id" ref="prod_mac_mini"/>
            <field name="sequence">50</field>
            <field name="label">尺寸與重量</field>
            <field name="value">高度 5.0 cm、寬度 12.7 cm、深度 12.7 cm
重量 0.67 kg</field>
        </record>

