<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Mac configurator-specific attributes, fully owned by this theme:
        attr_chip / attr_memory / attr_storage / attr_ethernet / attr_keyboard.

        顏色屬性（attr_color）的 apple_*/html_color 擴充、Mac-only 新色，以及
        Mac 分類，已改由 superinfo_website_data 提供
        （superinfo_website_data/data/product_mac_apple.xml）。本主題不再引用
        superinfo_website_data 的任何外部 ID，因此不依賴該資料模組。
    -->
    <data noupdate="1">

        <!-- ① 晶片 -->
        <record id="attr_chip" model="product.attribute">
            <field name="name">晶片</field>
            <field name="display_type">radio</field>
            <field name="create_variant">dynamic</field>
            <field name="apple_section_order">10</field>
            <field name="apple_group_label">晶片。</field>
            <field name="apple_subheading">各款強大選項任你選擇。</field>
            <field name="apple_price_display">starting</field>
        </record>
        <record id="attr_val_chip_m4" model="product.attribute.value">
            <field name="name">M4 晶片</field>
            <field name="attribute_id" ref="attr_chip"/>
            <field name="sequence">10</field>
            <field name="apple_description">澎湃的效能表現，幾乎可助你從容駕馭所有想做的工作。</field>
            <field name="apple_sub_label">10 核心 CPU、10 核心 GPU、16 核心神經網路引擎</field>
        </record>
        <record id="attr_val_chip_m4_pro" model="product.attribute.value">
            <field name="name">M4 Pro 晶片</field>
            <field name="attribute_id" ref="attr_chip"/>
            <field name="sequence">20</field>
            <field name="apple_description">擁有所有 M4 具備的先進技術，但威力更增強，可駕馭更繁重的任務。</field>
            <field name="apple_sub_label">12 核心 CPU、16 核心 GPU、16 核心神經網路引擎</field>
        </record>
        <record id="attr_val_chip_m4_max" model="product.attribute.value">
            <field name="name">M4 Max 晶片</field>
            <field name="attribute_id" ref="attr_chip"/>
            <field name="sequence">30</field>
            <field name="apple_description">為高階用戶與創作者打造的極致效能。</field>
            <field name="apple_sub_label">14 核心 CPU、32 核心 GPU、16 核心神經網路引擎</field>
        </record>
        <record id="attr_val_chip_m3" model="product.attribute.value">
            <field name="name">M3 晶片</field>
            <field name="attribute_id" ref="attr_chip"/>
            <field name="sequence">40</field>
            <field name="apple_description">高效能與長續航的優異組合。</field>
            <field name="apple_sub_label">8 核心 CPU、10 核心 GPU、16 核心神經網路引擎</field>
        </record>

        <!-- ② 記憶體 -->
        <record id="attr_memory" model="product.attribute">
            <field name="name">記憶體</field>
            <field name="display_type">radio</field>
            <field name="create_variant">dynamic</field>
            <field name="apple_section_order">20</field>
            <field name="apple_group_label">記憶體。</field>
            <field name="apple_subheading">選擇適合的容量。</field>
            <field name="apple_price_display">none</field>
        </record>
        <record id="attr_val_mem_8"   model="product.attribute.value"><field name="name">8GB</field>  <field name="attribute_id" ref="attr_memory"/><field name="sequence">10</field></record>
        <record id="attr_val_mem_16"  model="product.attribute.value"><field name="name">16GB</field> <field name="attribute_id" ref="attr_memory"/><field name="sequence">20</field></record>
        <record id="attr_val_mem_24"  model="product.attribute.value"><field name="name">24GB</field> <field name="attribute_id" ref="attr_memory"/><field name="sequence">30</field></record>
        <record id="attr_val_mem_32"  model="product.attribute.value"><field name="name">32GB</field> <field name="attribute_id" ref="attr_memory"/><field name="sequence">40</field></record>
        <record id="attr_val_mem_48"  model="product.attribute.value"><field name="name">48GB</field> <field name="attribute_id" ref="attr_memory"/><field name="sequence">50</field></record>
        <record id="attr_val_mem_64"  model="product.attribute.value"><field name="name">64GB</field> <field name="attribute_id" ref="attr_memory"/><field name="sequence">60</field></record>
        <record id="attr_val_mem_128" model="product.attribute.value"><field name="name">128GB</field><field name="attribute_id" ref="attr_memory"/><field name="sequence">70</field></record>

        <!-- ③ 儲存裝置 -->
        <record id="attr_storage" model="product.attribute">
            <field name="name">儲存裝置</field>
            <field name="display_type">radio</field>
            <field name="create_variant">dynamic</field>
            <field name="apple_section_order">30</field>
            <field name="apple_group_label">儲存裝置。</field>
            <field name="apple_subheading">選擇需要的儲存空間大小。</field>
            <field name="apple_price_display">none</field>
        </record>
        <record id="attr_val_storage_256" model="product.attribute.value"><field name="name">256GB</field><field name="attribute_id" ref="attr_storage"/><field name="sequence">10</field></record>
        <record id="attr_val_storage_512" model="product.attribute.value"><field name="name">512GB</field><field name="attribute_id" ref="attr_storage"/><field name="sequence">20</field></record>
        <record id="attr_val_storage_1tb" model="product.attribute.value"><field name="name">1TB</field>  <field name="attribute_id" ref="attr_storage"/><field name="sequence">30</field></record>
        <record id="attr_val_storage_2tb" model="product.attribute.value"><field name="name">2TB</field>  <field name="attribute_id" ref="attr_storage"/><field name="sequence">40</field></record>
        <record id="attr_val_storage_4tb" model="product.attribute.value"><field name="name">4TB</field>  <field name="attribute_id" ref="attr_storage"/><field name="sequence">50</field></record>
        <record id="attr_val_storage_8tb" model="product.attribute.value"><field name="name">8TB</field>  <field name="attribute_id" ref="attr_storage"/><field name="sequence">60</field></record>

        <!-- ④ 乙太網路 -->
        <record id="attr_ethernet" model="product.attribute">
            <field name="name">乙太網路</field>
            <field name="display_type">radio</field>
            <field name="create_variant">dynamic</field>
            <field name="apple_section_order">40</field>
            <field name="apple_group_label">乙太網路。</field>
            <field name="apple_subheading">選取速度。</field>
            <field name="apple_price_display">none</field>
        </record>
        <record id="attr_val_ether_1g" model="product.attribute.value">
            <field name="name">Gigabit 乙太網路</field>
            <field name="attribute_id" ref="attr_ethernet"/>
            <field name="sequence">10</field>
            <field name="apple_description">標準網路功能，連結速度最高可達 1Gb。</field>
        </record>
        <record id="attr_val_ether_10g" model="product.attribute.value">
            <field name="name">10 Gigabit 乙太網路</field>
            <field name="attribute_id" ref="attr_ethernet"/>
            <field name="sequence">20</field>
            <field name="apple_description">更高的連線頻寬，連結速度最高可達 10Gb。</field>
        </record>

        <!-- ⑤ 鍵盤 -->
        <record id="attr_keyboard" model="product.attribute">
            <field name="name">鍵盤</field>
            <field name="display_type">radio</field>
            <field name="create_variant">no_variant</field>
            <field name="apple_section_order">50</field>
            <field name="apple_group_label">鍵盤布局。</field>
        </record>
        <record id="attr_val_kb_zhuyin"    model="product.attribute.value"><field name="name">注音</field>    <field name="attribute_id" ref="attr_keyboard"/><field name="sequence">10</field></record>
        <record id="attr_val_kb_cangjie"   model="product.attribute.value"><field name="name">倉頡</field>    <field name="attribute_id" ref="attr_keyboard"/><field name="sequence">20</field></record>
        <record id="attr_val_kb_simplified" model="product.attribute.value"><field name="name">簡體中文</field><field name="attribute_id" ref="attr_keyboard"/><field name="sequence">30</field></record>
        <record id="attr_val_kb_english"   model="product.attribute.value"><field name="name">美式英文</field><field name="attribute_id" ref="attr_keyboard"/><field name="sequence">40</field></record>

    </data>
</odoo>
