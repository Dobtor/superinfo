<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Theme-specific fields for product categories.
        Base category records are owned by superinfo_website_data.
        We only set mac_subtitle / mac_tagline / mac_landing_order here.
    -->

    <!-- noupdate="0": always re-apply theme fields on upgrade -->
    <data noupdate="0">

        <!-- Mac root — update superinfo_website_data record -->
        <record id="superinfo_website_data.categ_mac" model="product.public.category">
            <field name="mac_subtitle">桌上型與筆記型</field>
        </record>

        <!-- iMac — update superinfo_website_data record (their ID: categ_mac_imac) -->
        <record id="superinfo_website_data.categ_mac_imac" model="product.public.category">
            <field name="mac_subtitle">桌上型</field>
            <field name="mac_tagline">驚艷你的全方位桌上型電腦</field>
            <field name="mac_landing_order">40</field>
        </record>

        <!-- Sub-categories only in theme (parent → superinfo_website_data.categ_mac) -->
        <record id="categ_macbook_neo" model="product.public.category">
            <field name="name">MacBook Neo</field>
            <field name="parent_id" ref="categ_mac"/>
            <field name="sequence">10</field>
            <field name="mac_subtitle">筆記型 — 全新</field>
            <field name="mac_tagline">為輕巧而生</field>
            <field name="mac_landing_order">10</field>
        </record>

        <record id="categ_macbook_air" model="product.public.category">
            <field name="name">MacBook Air</field>
            <field name="parent_id" ref="categ_mac"/>
            <field name="sequence">20</field>
            <field name="mac_subtitle">筆記型</field>
            <field name="mac_tagline">輕薄、強大、超長續航</field>
            <field name="mac_landing_order">20</field>
        </record>

        <record id="categ_macbook_pro" model="product.public.category">
            <field name="name">MacBook Pro</field>
            <field name="parent_id" ref="categ_mac"/>
            <field name="sequence">30</field>
            <field name="mac_subtitle">筆記型</field>
            <field name="mac_tagline">為專業而生</field>
            <field name="mac_landing_order">30</field>
        </record>

        <record id="categ_imac" model="product.public.category">
            <field name="name">iMac</field>
            <field name="parent_id" ref="categ_mac"/>
            <field name="sequence">40</field>
            <field name="mac_subtitle">桌上型</field>
            <field name="mac_tagline">驚艷你的全方位桌上型電腦</field>
            <field name="mac_landing_order">40</field>
        </record>

        <record id="categ_mac_mini" model="product.public.category">
            <field name="name">Mac mini</field>
            <field name="parent_id" ref="categ_mac"/>
            <field name="sequence">50</field>
            <field name="mac_subtitle">桌上型</field>
            <field name="mac_tagline">迷你體積，威猛實力</field>
            <field name="mac_landing_order">50</field>
        </record>

        <record id="categ_mac_studio" model="product.public.category">
            <field name="name">Mac Studio</field>
            <field name="parent_id" ref="categ_mac"/>
            <field name="sequence">60</field>
            <field name="mac_subtitle">桌上型</field>
            <field name="mac_tagline">強大、緊湊、為工作室而生</field>
            <field name="mac_landing_order">60</field>
        </record>

        <record id="categ_studio_display" model="product.public.category">
            <field name="name">Studio Display</field>
            <field name="parent_id" ref="categ_mac"/>
            <field name="sequence">70</field>
            <field name="mac_subtitle">顯示器</field>
            <field name="mac_tagline">耀眼一見的桌上型顯示器</field>
            <field name="mac_landing_order">70</field>
        </record>

        <record id="categ_studio_display_xdr" model="product.public.category">
            <field name="name">Pro Display XDR</field>
            <field name="parent_id" ref="categ_mac"/>
            <field name="sequence">80</field>
            <field name="mac_subtitle">顯示器 — 專業級</field>
            <field name="mac_tagline">為專業工作室打造</field>
            <field name="mac_landing_order">80</field>
        </record>

    </data>
</odoo>