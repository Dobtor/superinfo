<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Use search= to look up ir.model by model name directly,
             avoiding the external-ID timing problem that occurs during
             module upload in Odoo 18. -->
        <record id="access_mac_compare_spec_user" model="ir.model.access">
            <field name="name">mac.compare.spec.user</field>
            <field name="model_id" search="[('model', '=', 'mac.compare.spec')]"/>
            <field name="group_id" ref="base.group_user"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="access_mac_compare_spec_manager" model="ir.model.access">
            <field name="name">mac.compare.spec.manager</field>
            <field name="model_id" search="[('model', '=', 'mac.compare.spec')]"/>
            <field name="group_id" ref="base.group_system"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        <record id="access_mac_compare_spec_public" model="ir.model.access">
            <field name="name">mac.compare.spec.public</field>
            <field name="model_id" search="[('model', '=', 'mac.compare.spec')]"/>
            <field name="group_id" ref="base.group_public"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="access_mac_compare_spec_portal" model="ir.model.access">
            <field name="name">mac.compare.spec.portal</field>
            <field name="model_id" search="[('model', '=', 'mac.compare.spec')]"/>
            <field name="group_id" ref="base.group_portal"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
